rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sessions: anyone can create, only owner can update/read
    match /sessions/{sessionId} {
      allow create: if request.resource.data.keys().hasAll([
        'ticketId', 'destination', 'status', 'startedAt'
      ]);
      allow update: if resource.data.status == 'active'
        && request.resource.data.status in ['completed', 'exited'];
      allow read: if false; // sessions are write-only for privacy
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
